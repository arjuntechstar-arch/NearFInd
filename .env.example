# API
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://nearfind:nearfind_local@localhost:5432/nearfind

# OIDC resource-server configuration.
# Required in staging/production. Use your trusted identity provider values.
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_AUDIENCE=nearfind-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Comma-separated asymmetric signature algorithms only.
OIDC_ALLOWED_ALGORITHMS=RS256

# Web/mobile API endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1
