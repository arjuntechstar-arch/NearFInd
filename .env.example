# API
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://nearfind:nearfind_local@localhost:5432/nearfind
REDIS_URL=redis://localhost:6379

# Local development authentication.
# This creates local USER/PROVIDER/ADMIN sessions without any external identity provider.
# Staging/production must set this to false and configure OIDC below.
DEV_AUTH_ENABLED=true
EXPO_PUBLIC_DEV_AUTH_ENABLED=true

# External nearby-place discovery.
# Development can use the public Overpass endpoint for light/manual testing only.
# Production must point OVERPASS_API_URL at a self-hosted or commercial endpoint.
EXTERNAL_PLACES_PROVIDER=overpass
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
EXTERNAL_PLACES_USER_AGENT=NearFind/0.1 (+https://example.com/contact)
EXTERNAL_PLACES_DEFAULT_COUNTRY=IN
EXTERNAL_PLACES_MAX_RADIUS_METERS=10000

# OIDC resource-server configuration.
# Required in staging/production. These development placeholders are ignored while DEV_AUTH_ENABLED=true.
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_AUDIENCE=nearfind-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256

# Sensitive-field encryption.
# Staging/production require a base64-encoded random 32-byte key from a secret manager/KMS.
# Development/test intentionally use a local-only fallback when this is omitted.
# FIELD_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# S3-compatible private media storage. These example credentials are local MinIO-only.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nearfind-media
S3_ACCESS_KEY_ID=nearfind
S3_SECRET_ACCESS_KEY=nearfind-local-change-me

# Region-specific direct public emergency calling. This is separate from private NearFind roadside support.
EMERGENCY_REGION=IN
EMERGENCY_NUMBER=112

# Server-side web BFF OAuth configuration. Use a public Authorization Code + PKCE client in deployed environments.
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/v1
OIDC_WEB_ISSUER_URL=https://identity.example.com
OIDC_WEB_CLIENT_ID=nearfind-web
OIDC_WEB_REDIRECT_URI=http://localhost:3000/auth/callback

# Browser/mobile public endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Mobile public-client OIDC configuration (Authorization Code + PKCE) for deployed builds.
EXPO_PUBLIC_OIDC_ISSUER_URL=https://identity.example.com
EXPO_PUBLIC_OIDC_CLIENT_ID=nearfind-mobile
