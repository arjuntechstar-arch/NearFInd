# API
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://nearfind:nearfind_local@localhost:5432/nearfind

# OIDC resource-server configuration.
# Required in staging/production. Use your trusted identity provider values.
OIDC_ISSUER_URL=https://identity.example.com/
OIDC_AUDIENCE=nearfind-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_ALLOWED_ALGORITHMS=RS256

# Server-side web BFF OAuth configuration. Use a public Authorization Code + PKCE client; do not add a client secret.
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/v1
OIDC_WEB_ISSUER_URL=https://identity.example.com
OIDC_WEB_CLIENT_ID=nearfind-web
OIDC_WEB_REDIRECT_URI=http://localhost:3000/auth/callback

# Browser/mobile public endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Mobile public-client OIDC configuration (Authorization Code + PKCE).
EXPO_PUBLIC_OIDC_ISSUER_URL=https://identity.example.com
EXPO_PUBLIC_OIDC_CLIENT_ID=nearfind-mobile
